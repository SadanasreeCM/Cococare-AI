# Roboflow Model & API Key
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL=coconut-tree-disease
ROBOFLOW_VERSION=1

# Groq AI API Key (for multilingual chatbot)
GROQ_API_KEY=your_groq_api_key_here

# Backend & Server Settings
BACKEND_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./data/cococare.db

# Storage Directories
UPLOADS_DIR=./uploads
